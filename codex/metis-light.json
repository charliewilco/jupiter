{
  "name": "metis-light",
  "type": "light",
  "colors": {
    "activityBar.background": "#E3ECF2",
    "activityBar.foreground": "#172631",
    "badge.background": "#007E9F",
    "badge.foreground": "#F7FAFC",
    "button.background": "#007E9F",
    "button.foreground": "#F7FAFC",
    "button.hoverBackground": "#007E9F",
    "diffEditor.insertedTextBackground": "#39773533",
    "diffEditor.removedTextBackground": "#AE343133",
    "dropdown.background": "#EDF4F8",
    "dropdown.border": "#C5D4DE",
    "editor.background": "#F7FAFC",
    "editor.foreground": "#172631",
    "editor.findMatchBackground": "#77670066",
    "editor.findMatchHighlightBackground": "#77670033",
    "editor.lineHighlightBackground": "#DCE7EE",
    "editor.selectionBackground": "#B8DAE6",
    "editor.selectionHighlightBackground": "#B8DAE666",
    "editorCursor.foreground": "#007E9F",
    "editorGroup.border": "#C5D4DE",
    "editorGutter.addedBackground": "#397735",
    "editorGutter.deletedBackground": "#AE3431",
    "editorGutter.modifiedBackground": "#8F6800",
    "editorLineNumber.activeForeground": "#007E9F",
    "editorLineNumber.foreground": "#718493",
    "input.background": "#EDF4F8",
    "input.border": "#C5D4DE",
    "input.foreground": "#172631",
    "list.activeSelectionBackground": "#B8DAE6",
    "list.activeSelectionForeground": "#172631",
    "list.hoverBackground": "#DCE7EE",
    "panel.background": "#F7FAFC",
    "panel.border": "#C5D4DE",
    "peekView.border": "#007E9F",
    "sideBar.background": "#E3ECF2",
    "sideBar.foreground": "#4B6070",
    "sideBarSectionHeader.background": "#DCE7EE",
    "statusBar.background": "#DCE7EE",
    "statusBar.foreground": "#172631",
    "statusBar.noFolderBackground": "#DCE7EE",
    "tab.activeBackground": "#F7FAFC",
    "tab.activeForeground": "#172631",
    "tab.border": "#C5D4DE",
    "tab.inactiveBackground": "#E3ECF2",
    "tab.inactiveForeground": "#4B6070",
    "terminal.ansiBlack": "#F7FAFC",
    "terminal.ansiBlue": "#1A63C9",
    "terminal.ansiBrightBlack": "#718493",
    "terminal.ansiBrightBlue": "#515ABD",
    "terminal.ansiBrightCyan": "#007E9F",
    "terminal.ansiBrightGreen": "#1C7E67",
    "terminal.ansiBrightMagenta": "#7446B0",
    "terminal.ansiBrightRed": "#BF385B",
    "terminal.ansiBrightWhite": "#FFFFFF",
    "terminal.ansiBrightYellow": "#776700",
    "terminal.ansiCyan": "#007E9F",
    "terminal.ansiGreen": "#397735",
    "terminal.ansiMagenta": "#A83B80",
    "terminal.ansiRed": "#AE3431",
    "terminal.ansiWhite": "#172631",
    "terminal.ansiYellow": "#8F6800",
    "titleBar.activeBackground": "#E3ECF2",
    "titleBar.activeForeground": "#172631"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#718493",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "constant.other.symbol",
        "constant.other.key"
      ],
      "settings": {
        "foreground": "#1C7E67"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric",
        "constant.language.boolean",
        "constant.language.null"
      ],
      "settings": {
        "foreground": "#776700"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#8F6800"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#515ABD"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#1A63C9"
      }
    },
    {
      "name": "Type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "storage.type.cs"
      ],
      "settings": {
        "foreground": "#397735"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "support.variable",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#1A63C9"
      }
    },
    {
      "name": "Property",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#007E9F"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#1A63C9"
      }
    },
    {
      "name": "Attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#007E9F"
      }
    },
    {
      "name": "Regular Expression",
      "scope": [
        "string.regexp",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#BF385B"
      }
    },
    {
      "name": "Markup Heading",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#A84F22",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup Link",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#007E9F"
      }
    },
    {
      "name": "Markup Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#A83B80",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#A83B80",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Inserted",
      "scope": [
        "markup.inserted",
        "diff.header.to-file"
      ],
      "settings": {
        "foreground": "#397735"
      }
    },
    {
      "name": "Deleted",
      "scope": [
        "markup.deleted",
        "diff.header.from-file"
      ],
      "settings": {
        "foreground": "#AE3431"
      }
    },
    {
      "name": "Changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#8F6800"
      }
    }
  ],
  "semanticHighlighting": true,
  "displayName": "Metis Light"
}
