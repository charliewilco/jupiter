{
  "name": "metis-vscode-theme",
  "displayName": "Metis",
  "publisher": "charlespeters",
  "description": "Metis themes for VSCode.",
  "version": "3.0.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/charlespeters/metis"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Themes"
  ],
  "files": [
    "LICENSE",
    "package.json",
    "themes/*.json"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Metis Dark",
        "uiTheme": "vs-dark",
