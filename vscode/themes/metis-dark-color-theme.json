{
  "name": "Metis Dark",
  "type": "dark",
  "colors": {
    "activityBar.background": "#070B10",
    "activityBar.foreground": "#E1EBF2",
    "badge.background": "#4ACDEB",
    "badge.foreground": "#0C1218",
    "button.background": "#4ACDEB",
    "button.foreground": "#0C1218",
    "button.hoverBackground": "#4ACDEB",
    "diffEditor.insertedTextBackground": "#7FC86B33",
    "diffEditor.removedTextBackground": "#FF665D33",
    "dropdown.background": "#131D26",
    "dropdown.border": "#30424F",
    "editor.background": "#0C1218",
    "editor.foreground": "#E1EBF2",
    "editor.findMatchBackground": "#E7C95166",
    "editor.findMatchHighlightBackground": "#E7C95133",
    "editor.lineHighlightBackground": "#1B2834",
    "editor.selectionBackground": "#24596F",
    "editor.selectionHighlightBackground": "#24596F66",
    "editorCursor.foreground": "#4ACDEB",
    "editorGroup.border": "#30424F",
    "editorGutter.addedBackground": "#7FC86B",
    "editorGutter.deletedBackground": "#FF665D",
    "editorGutter.modifiedBackground": "#F0AD2E",
    "editorLineNumber.activeForeground": "#4ACDEB",
    "editorLineNumber.foreground": "#7A8B98",
    "input.background": "#131D26",
    "input.border": "#30424F",
    "input.foreground": "#E1EBF2",
    "list.activeSelectionBackground": "#24596F",
    "list.activeSelectionForeground": "#E1EBF2",
    "list.hoverBackground": "#1B2834",
    "panel.background": "#0C1218",
    "panel.border": "#30424F",
    "peekView.border": "#4ACDEB",
    "sideBar.background": "#070B10",
    "sideBar.foreground": "#AFBBC4",
    "sideBarSectionHeader.background": "#1B2834",
    "statusBar.background": "#1B2834",
    "statusBar.foreground": "#E1EBF2",
    "statusBar.noFolderBackground": "#1B2834",
    "tab.activeBackground": "#0C1218",
    "tab.activeForeground": "#E1EBF2",
    "tab.border": "#30424F",
    "tab.inactiveBackground": "#070B10",
    "tab.inactiveForeground": "#AFBBC4",
    "terminal.ansiBlack": "#0C1218",
    "terminal.ansiBlue": "#70A8FF",
    "terminal.ansiBrightBlack": "#7A8B98",
    "terminal.ansiBrightBlue": "#9B9FFF",
    "terminal.ansiBrightCyan": "#4ACDEB",
    "terminal.ansiBrightGreen": "#58D0A8",
    "terminal.ansiBrightMagenta": "#B987FF",
    "terminal.ansiBrightRed": "#FF7795",
    "terminal.ansiBrightWhite": "#F5FAFD",
    "terminal.ansiBrightYellow": "#E7C951",
    "terminal.ansiCyan": "#4ACDEB",
    "terminal.ansiGreen": "#7FC86B",
    "terminal.ansiMagenta": "#EB70BE",
    "terminal.ansiRed": "#FF665D",
    "terminal.ansiWhite": "#E1EBF2",
    "terminal.ansiYellow": "#F0AD2E",
    "titleBar.activeBackground": "#070B10",
    "titleBar.activeForeground": "#E1EBF2"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7A8B98",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "constant.other.symbol",
        "constant.other.key"
      ],
      "settings": {
        "foreground": "#58D0A8"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric",
        "constant.language.boolean",
        "constant.language.null"
      ],
      "settings": {
        "foreground": "#E7C951"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#F0AD2E"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#9B9FFF"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#70A8FF"
      }
    },
    {
      "name": "Type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "storage.type.cs"
      ],
      "settings": {
        "foreground": "#7FC86B"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "support.variable",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#70A8FF"
      }
    },
    {
      "name": "Property",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#4ACDEB"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#70A8FF"
      }
    },
    {
      "name": "Attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#4ACDEB"
      }
    },
    {
      "name": "Regular Expression",
      "scope": [
        "string.regexp",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#FF7795"
      }
    },
    {
      "name": "Markup Heading",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#FF8B4C",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup Link",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#4ACDEB"
      }
    },
    {
      "name": "Markup Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#EB70BE",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#EB70BE",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Inserted",
      "scope": [
        "markup.inserted",
        "diff.header.to-file"
      ],
      "settings": {
        "foreground": "#7FC86B"
      }
    },
    {
      "name": "Deleted",
      "scope": [
        "markup.deleted",
        "diff.header.from-file"
      ],
      "settings": {
        "foreground": "#FF665D"
      }
    },
    {
      "name": "Changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#F0AD2E"
      }
    }
  ],
  "semanticHighlighting": true
}
